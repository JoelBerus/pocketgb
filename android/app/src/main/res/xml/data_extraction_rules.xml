<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia en la nube y transferencia entre dispositivos (Android 12+). Política de partidas (A5, decisión J3):
    - Nube: se respalda `saves/<huella>.sav`, pero no `saves/backups/` (rotación y cuarentena de la propia
      partida) ni `states/` (voluminosos y regenerables), para no agotar la cuota de 25 MiB.
    - Transferencia entre teléfonos: se lleva todo (partidas, backups y estados), porque es un cable o una
      red local sin cuota y es el momento en que más se agradece conservar el historial.
    - El URI de la carpeta (library_folder) no viaja en ningún caso: es un permiso SAF ligado al dispositivo.
    SOLO `<exclude>`, jamás `<include>` (volvería lista blanca; lo verifica ManifestPolicyTest).
    Riesgo documentado: tras restaurar, la mtime nueva del `.sav` puede hacer ganar a una local antigua en la
    resolución al abrir; el perdedor se conserva en `saves/backups/` (nunca se descarta sin respaldo).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="library_folder.xml" />
        <exclude domain="file" path="saves/backups/" />
        <exclude domain="file" path="states/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="library_folder.xml" />
    </device-transfer>
</data-extraction-rules>
