# Diccionario de libFuzzer para fuzz_pgbm (make fuzz-pgbm): mágico, tipos de sección,
# firma PNG y secuencias UTF-8 en el borde de la validez.
magic="PGBM"
version1="\x01\x00"
tag_romf="ROMF"
tag_meta="META"
tag_thmb="THMB"
tag_save="SAVE"
tag_stat="STAT"
tag_xtra_critical="XTRA"
tag_xtra_auxiliary="xtra"
tag_upper_edge_a="Axyz"
tag_upper_edge_z="Zxyz"
tag_below_a="@xyz"
tag_above_z="[xyz"
png_sig="\x89PNG\x0D\x0A\x1A\x0A"
utf8_ok_2="\xC3\xA9"
utf8_ok_3="\xE2\x82\xAC"
utf8_ok_4="\xF0\x9F\x98\x80"
utf8_max="\xF4\x8F\xBF\xBF"
utf8_surrogate_lo="\xED\xA0\x80"
utf8_surrogate_hi="\xED\xBF\xBF"
utf8_above_max="\xF4\x90\x80\x80"
utf8_overlong_2="\xC0\x80"
utf8_overlong_3="\xE0\x80\x80"
utf8_overlong_4="\xF0\x80\x80\x80"
utf8_f5="\xF5\x80\x80\x80"
utf8_lone_cont="\x80"
nul="\x00"
